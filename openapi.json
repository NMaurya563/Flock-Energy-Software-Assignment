  "components": {
    "schemas": {
      "CacheMetadata": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "not_loaded",
              "fresh",
              "expired"
            ],
            "title": "State"
          },
          "cached_meters": {
            "type": "integer",
            "title": "Cached Meters"
          },
          "fetched_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetched At"
          },
          "age_seconds": {
            "anyOf": [
              {
                "type": "number"
